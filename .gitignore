# ---------------------------------------------------------------------------
# ScanNet++ terms forbid redistribution: no data, nothing derived from data
# (point clouds, images, overlays, features, predictions) may ever be committed.
# ---------------------------------------------------------------------------
data/
datasets/
raw/
processed/
features/
cache/
outputs/
exp/
checkpoints/
wheelhouse/

